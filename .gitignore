# Dépendances (ne jamais pousser sur Git)
node_modules/
package-lock.json
*/node_modules/

# Fichiers sensibles et variables d'environnement
.env
.env.*
.env.local
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Builds et sorties de compilation
dist/
dist-ssr/
frontend/dist/
build/
*.local

# Fichiers médias téléversés par les utilisateurs (on conserve le dossier avec .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs et traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Éditeurs et systèmes d'exploitation
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
