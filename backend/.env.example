# ==========================================
# Configuration de Production - MyFolio
# ==========================================

# Environnement (production ou development)
NODE_ENV=development

# Port d'écoute du serveur
PORT=5000

# URL de connexion à la base de données MongoDB (ex: MongoDB Atlas en production)
MONGODB_URI=mongodb://127.0.0.1:27017/myfolio

# Désactiver le fallback en mémoire en production (OBLIGATOIRE pour éviter la perte de données)
USE_IN_MEMORY_DB_FALLBACK=false

# Clé secrète JWT pour la signature des sessions utilisateurs
# (Générer une clé robuste : openssl rand -hex 64)
JWT_SECRET=remplacez_cette_cle_par_un_secret_aleatoire_et_robuste_en_production

# URL autorisées pour CORS et liens d'e-mails (URL de votre application frontend déployée)
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Configuration SMTP pour l'envoi d'e-mails réels (optionnel en développement)
# Si non configuré, le lien de réinitialisation est affiché dans la console du backend et directement dans l'interface
# Pour Gmail : utilisez un "Mot de passe d'application" Google (2FA requis)
# SMTP_SERVICE=gmail
# SMTP_USER=votre_email@gmail.com
# SMTP_PASS=votre_mot_de_passe_application_16_caracteres
#
# Ou avec un serveur SMTP personnalisé (Brevo, SendGrid, etc.) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre_identifiant_smtp
# SMTP_PASS=votre_cle_smtp

